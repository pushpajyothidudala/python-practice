        "#set.union()-it gives union of two sets\n",
        "s1={1,2,3,4}\n",
        "s2={3,4,5,6,7}\n",
        "s3=s1.union(s2)\n",
        "print(s3)\n",
        "#set.intersection()-it gives intersection of two elements\n",
        "s3=s1.intersection(s2)\n",
        "print(s3)\n",
        "#set.isdisjoint()-returns true if no common elements,returns false if commom elements\n",
        "s4=s1.isdisjoint(s2)\n",
        "print(s4)\n",
        "#set.difference()-setA-setB it will remove set b elements in set a,same way setB-setA\n",
        "print(s1-s2)\n",
        "print(s2-s1)\n",
        "#set.symmetric_difference():i want to remove common elements and needed both sets uncommon elements not one set then we will use this one\n",
        "print(s1.symmetric_difference(s2))\n",
        "#we can write it in other way\n",
        "print(s1.union(s2)-s1.intersection(s2))\n",
        "#s1.issubset(s2) method returns true,if the s1 is subset of s2 means all the elements in s2 has to be there in s1\n",
